</BaseLayout>

<script>
    import { mountVacuumRoom } from "../../scripts/vacuumRoom";

    let cleanups: (() => void)[] = [];

    function mountClips(): () => void {
        const videos = [...document.querySelectorAll<HTMLVideoElement>("video[data-clip]")];
        if (!videos.length) return () => {};
        const still = window.matchMedia("(prefers-reduced-motion: reduce)");
        if (still.matches) return () => {};
        // With motion allowed, the clips play like GIFs while they're on screen: no controls, muted, looping.
        for (const v of videos) v.removeAttribute("controls");
        const io = new IntersectionObserver(
            (entries) => {
                for (const e of entries) {
                    const v = e.target as HTMLVideoElement;
                    if (e.isIntersecting) v.play().catch(() => v.setAttribute("controls", ""));
                    else v.pause();
                }
            },
            { rootMargin: "120px 0px" },
        );
        videos.forEach((v) => io.observe(v));
        return () => io.disconnect();
    }

    function mountTrailer(): () => void {
        const link = document.querySelector<HTMLAnchorElement>("a[data-yt]");
        if (!link) return () => {};
        const onClick = (e: MouseEvent) => {
            if (e.metaKey || e.ctrlKey || e.shiftKey) return;
            e.preventDefault();
            const iframe = document.createElement("iframe");
            iframe.src = `https://www.youtube-nocookie.com/embed/${link.dataset.yt}?autoplay=1&rel=0`;
            iframe.title = "Vacuum Simulator trailer";
            iframe.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
            iframe.allowFullscreen = true;
            iframe.className = "vs-yt-frame";
            link.replaceWith(iframe);
            iframe.focus();
        };
        link.addEventListener("click", onClick);
        return () => link.removeEventListener("click", onClick);
    }

    function mount() {
        cleanups.forEach((c) => c());
        cleanups = [];
        const room = document.querySelector<HTMLElement>("[data-room]");
        if (!room) return;
        cleanups.push(mountVacuumRoom(room), mountClips(), mountTrailer());
    }

    document.addEventListener("astro:page-load", mount);
    document.addEventListener("astro:before-swap", () => {
        cleanups.forEach((c) => c());
        cleanups = [];
    });
</script>

